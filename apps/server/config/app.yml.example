# phytomni-server runtime configuration template.
#
# Copy this file to `app.yml` in the same directory, then fill in real
# values; do NOT commit `app.yml` — the matching .gitignore rule keeps
# it out of git so live credentials never enter version control.

# ---------------------------------------------------------------------
# Application identity + log verbosity
# ---------------------------------------------------------------------
# `app.trusted_proxies` feeds gin.Engine.SetTrustedProxies (server/http.go)
# so X-Forwarded-* headers from these CIDRs are honored. Default in code
# is ["192.0.0.0/8", "172.16.0.0/12"]; override here if your ingress sits
# in a different subnet (Kubernetes overlay, public load balancer, etc.).
app:
  trusted_proxies:
    - "192.0.0.0/8"
    - "172.16.0.0/12"
debug: true

# ---------------------------------------------------------------------
# JWT signing secret — MUST equal SECRET_KEY_CLIENT in the Python
# sibling's .env, otherwise tokens issued by one side fail verification
# on the other. Use a long random string (e.g. `openssl rand -hex 32`).
# ---------------------------------------------------------------------
jwt:
  secret_key: "your-random-jwt-secret"

# ---------------------------------------------------------------------
# MySQL connection. The Logger hook (db/logger.go) writes every SQL
# into sql_operation_logs, so the DSN user needs INSERT on that table
# plus the User-family tables. Format:
#   <user>:<pass>@tcp(<host>:<port>)/<db>?<gorm-flags>
# ---------------------------------------------------------------------
db:
  phytomni-server:
    dialect: mysql
    dsn: "root:your-mysql-password@tcp(localhost:3306)/phytomni?charset=utf8mb4&parseTime=True&loc=Local"

# ---------------------------------------------------------------------
# Redis cache (cache/client.go); currently initialized but main.go
# leaves the client commented out, so this section only matters once
# the cache layer is wired in.
# ---------------------------------------------------------------------
redis:
  clients:
    web:
      addrs:
        - "your-redis-host:6379"
      db: 0
      password:
      type: single-node
  default: default

# ---------------------------------------------------------------------
# Structured logging sinks
# ---------------------------------------------------------------------
log:
  outputs:
    - stdout
    - ./logs/api.log

# ---------------------------------------------------------------------
# Feature switches — http server + cron scheduler
#
# `http.switch` is the master kill-switch for the gin engine wiring.
# `http.gzip` toggles the gzip response middleware (off by default —
# turning it on burns CPU on small responses but trims body size for
# the large analyst-agent payloads). `http.maintenance` flips every
# non-health route to 503 so ops can drain traffic before a deploy.
# ---------------------------------------------------------------------
http:
  switch: true
  gzip: false
  maintenance: false
cron:
  switch: true

# ---------------------------------------------------------------------
# Gene example file root — ApiGeneDetails reads files from here.
# Point at the directory that holds the per-gene .out artifacts the
# Python MCP server emits.
# ---------------------------------------------------------------------
gene_file_path: "/var/lib/phytomni/gene_examples"

# ---------------------------------------------------------------------
# Default chat quota for newly-created guest accounts. ApiUserRegister
# reads this for the `guest` role; logged-in vip/user roles are
# unbounded.
# ---------------------------------------------------------------------
guest_default_chat_limit: 5

# ---------------------------------------------------------------------
# bcrypt work factor for password hashing (utils/password.go). Omit or
# set 0 to use the library default (10). Allowed range is [10,31]; the
# server refuses to boot on a value outside it (no silent downgrade).
# Higher = stronger but slower on EVERY login (incl. failures) — there
# is no login rate limiter, so cost x QPS is a CPU budget. Raise only
# after measuring p99 login latency on production hardware.
# ---------------------------------------------------------------------
bcrypt_cost: 10

# ---------------------------------------------------------------------
# Huawei Cloud IAM + EIHealth — service/api_service/agent_task.go
# uses these for the analyst-agent polling cron and the on-demand
# task-log fetch. The IAM block authenticates against a Huawei Cloud
# project; the EIHealth block points at the bioinformatics compute
# tenant where analyst tasks actually run.
#
# Rotate `iam.password` whenever the leaked sample value is suspected
# of being known to a third party (it is no longer the active one in
# this repository). Production typically deploys with region/auth_url
# wired together so both keys swap atomically on a region migration.
# ---------------------------------------------------------------------
huawei:
  # TLS certificate verification for the IAM + EIHealth polling clients
  # (service/api_service/agent_task.go). Default false = verify the cert chain.
  # Set true ONLY for a dev box behind a TLS-intercepting proxy — never in
  # production; it disables MITM protection on the IAM token exchange.
  insecure_skip_verify: false
  iam:
    user_name: "your-huawei-iam-user"
    password: "your-huawei-iam-password"
    domain_name: "your-huawei-iam-domain"
    project_name: "cn-east-3"
    auth_url: "https://iam.cn-east-3.myhuaweicloud.com/v3/auth/tokens"
  eihealth:
    base_url: "https://eihealth.cn-east-3.myhuaweicloud.com/v1"
    account_id: "your-huawei-account-id"
    project_uuid: "your-eihealth-project-uuid"

# ---------------------------------------------------------------------
# Bot service integration (Wave A multi-tenant proxy).
#
# `base_url`         — Bot's HTTP root (production: internal VPC URL).
# `user_api_key`     — ONE `ptm_…` user-scoped Bot key for the whole
#                      Web app. Multi-tenant model: Bot treats this
#                      Web as one principal; real-user identity lives
#                      in Web Go MySQL (user_operation_logs etc.).
#                      Ops issues this ONCE at deploy via:
#                        curl -X POST <bot>/v1/api-keys \
#                          -H 'Authorization: Bearer <service-token>' \
#                          -d '{"user_id":"web","name":"chat-ai-web-app"}'
#                      The service token never enters this file —
#                      it stays with ops + Bot side only.
#                      The key MUST carry the `relay:obs` scope (Bot
#                      denies relay routes to scope-less keys) and the
#                      Bot deployment must set RELAY_ENABLED=true —
#                      the gene/analyst result downloads go through
#                      Bot's OBS relay (/v1/relay/obs/*); the gateway
#                      holds no Huawei OBS credentials.
# `proxy_enabled`    — gates the Bot integration. After the cutover the Go
#                      gateway is the SOLE /query handler (the Python MCP
#                      service was removed), so this must be true in any real
#                      deployment; ValidateAgents fail-fast at boot if Bot is
#                      unreachable. Use false only for a Bot-less local boot
#                      that never serves /query.
# `key_audit_redact` — when true, loggers must never emit the full
#                      user_api_key string (only first 8 chars prefix).
#                      The bot HTTP client honors this (landed by B-2).
# Rotate `user_api_key` per Bot runbook ~90 days; ops procedure is
# (1) issue new key via service-token curl above,
# (2) edit production app.yml,
# (3) restart Web Go,
# (4) revoke old key via DELETE /v1/api-keys/{prefix}.
# ---------------------------------------------------------------------
bot:
  base_url: "http://localhost:8000"
  user_api_key: "REPLACE_ME"
  timeout_seconds: 900    # gateway↔Bot HTTP client timeout. MUST exceed the slowest SYNC agent's latency — prod observed chat ~140s / knowledge ~198s / review >300s (RAG-heavy). Async agents (analyst/deep_genome) return a task_id fast and are not bound by this. Legacy Python used a 10h request timeout; pick per the slowest sync agent you serve.
  proxy_enabled: true
  key_audit_redact: true
  # /query upload bounds (0 or omitted = built-in default). Tune without recompiling.
  max_upload_file_bytes: 26214400    # 25 MiB per file (matches Bot /v1/files 413)
  max_upload_file_count: 10
  max_upload_total_bytes: 52428800   # 50 MiB per request

# ---------------------------------------------------------------------
# Outbound notification email — common/email/email_send.go.
# `web_base_url` / `api_base_url` are stitched into the link bodies of
# the notification email (chat page + OBS file download). `from_*` are
# the QQ-SMTP credentials used to actually send. The auth code is a
# real production credential previously inlined as a literal; rotating
# requires updating config/app.yml + restarting the Go service.
# ---------------------------------------------------------------------
email:
  web_base_url: "http://your-web-host"
  api_base_url: "http://your-api-host:8080"
  smtp_server: "smtp.qq.com"
  smtp_port: 587
  from_display: "nky_email <your-sender@qq.com>"
  from_address: "your-sender@qq.com"
  from_auth_code: "your-qq-smtp-auth-code"
