# chat-ai production-mode environment template
#
# Copy to `.env.production` in this directory and fill in real values; do NOT
# commit `.env.production` — the .gitignore rule keeps it out of git so live
# endpoints stay separate from any tracked sample.
#
# Vite loads this file when `vite build --mode production` runs (see
# package.json `build-only` script), so VITE_* keys here override `.env`
# defaults.

# Whether Babel transpiles modules at build time (vite-plugin-babel)
VITE_BABEL_TRANSPILE_MODULES = true

# Browser tab title shown in production
VITE_APP_TITLE = "Phytomni"

# Vite mode marker
VITE_APP_ENV = 'production'

# Static-asset URL prefix; empty for same-origin deployment (nginx serves
# the SPA from /). Set to a sub-path only if the app is mounted under a
# non-root location (e.g. '/app' for https://example.com/app/).
VITE_APP_BASE_URL = ''

# API gateway prefix — must match the nginx reverse-proxy rules that route
# /auth to the Go gateway at :8080.
VITE_BASE_API = '/auth'

# File-upload gateway prefix (Huawei OBS dispatch route)
VITE_FILE_BASE = '/ftnet-gateway'

# AnalystAgent attachment base URL — DeepGenomeResultViewer rewrites the
# ./.out/xxxx paths returned by the agent into <base>xxxx. In production
# nginx serves /attachments/ from the gene examples directory.
VITE_ATTACHMENTS_BASE_URL = '/attachments/'
