{
  "include": [
    "vite.config.mts",
    "vite/**/*.ts",
    "vitest.config.mts",
    "cypress.config.*"
  ],
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "module": "esnext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "useDefineForClassFields": true,
    "jsx": "preserve",
    "noImplicitThis": true,
    "strict": true,
    "isolatedModules": true,
    "target": "esnext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  }
}
