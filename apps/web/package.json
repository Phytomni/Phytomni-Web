{
  "name": "phytomni-web",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite --mode dev",
    "dev:prod": "vite --mode production",
    "host": "vite --host --mode dev",
    "build": "run-p type-check build-only",
    "preview": "vite preview --port 4173",
    "build-only:raw": "vite build --mode production",
    "build-only": "node scripts/quality/run-with-warning-oracle.mjs build",
    "type-check": "vue-tsc --noEmit",
    "lint": "python3 ../../scripts/check_static_analysis_exemptions.py --check --collector eslint",
    "lint:raw": "eslint src tests vite vite.config.mts vitest.config.mts .eslintrc.cjs --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --max-warnings 0 --format json",
    "format:check": "prettier --check \"src/**/*.{vue,js,jsx,cjs,mjs,ts,tsx,cts,mts}\" \"tests/**/*.{vue,js,jsx,cjs,mjs,ts,tsx,cts,mts}\" \"vite/**/*.{js,jsx,cjs,mjs,ts,tsx,cts,mts}\" \"*.{js,jsx,cjs,mjs,ts,tsx,cts,mts}\" .eslintrc.cjs .prettierrc.cjs",
    "format:write": "prettier --write \"src/**/*.{vue,js,jsx,cjs,mjs,ts,tsx,cts,mts}\" \"tests/**/*.{vue,js,jsx,cjs,mjs,ts,tsx,cts,mts}\" \"vite/**/*.{js,jsx,cjs,mjs,ts,tsx,cts,mts}\" \"*.{js,jsx,cjs,mjs,ts,tsx,cts,mts}\" .eslintrc.cjs .prettierrc.cjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:warning-oracle": "node --test --test-isolation=none scripts/quality/framework-warning-oracle.test.mjs",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "3dmol": "2.5.5",
    "axios": "^1.2.6",
    "element-plus": "^2.10.1",
    "file-saver": "^2.0.5",
    "js-cookie": "^3.0.1",
    "nprogress": "^0.2.0",
    "pinia": "^2.0.17",
    "vue": "^3.2.37",
    "vue-element-plus-x": "^1.3.2",
    "vue-i18n": "^9.13.1",
    "vue-router": "^4.1.3"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.1.4",
    "@types/babel__core": "7.20.5",
    "@types/js-cookie": "^3.0.2",
    "@types/node": "26.1.1",
    "@types/nprogress": "^0.2.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/eslint-config-prettier": "^7.0.0",
    "@vue/eslint-config-typescript": "^11.0.0",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "0.9.1",
    "eslint": "^8.21.0",
    "eslint-plugin-vue": "^9.3.0",
    "happy-dom": "^15.11.7",
    "npm-run-all2": "9.0.2",
    "prettier": "2.7.1",
    "sass": "1.101.7",
    "typescript": "6.0.3",
    "unplugin-auto-import": "21.0.0",
    "vite": "5.4.21",
    "vite-plugin-compression2": "2.5.3",
    "vitest": "^2.1.9",
    "vue-tsc": "3.3.8"
  }
}
