{
  "name": "phytomni-web",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite --mode dev",
    "dev:prod": "vite --mode production",
    "host": "vite --host --mode dev",
    "build": "run-p type-check build-only",
    "preview": "vite preview --port 4173",
    "build-only:raw": "vite build --mode production",
    "build-only": "node scripts/quality/run-with-warning-oracle.mjs build",
    "type-check": "vue-tsc --noEmit",
    "lint": "python3 ../../scripts/check_static_analysis_exemptions.py --check --collector eslint",
    "lint:raw": "eslint src tests vite vite.config.mts vitest.config.mts eslint.config.mjs --max-warnings 0 --format json",
    "format:check": "prettier --check \"src/**/*.{vue,js,jsx,cjs,mjs,ts,tsx,cts,mts}\" \"tests/**/*.{vue,js,jsx,cjs,mjs,ts,tsx,cts,mts}\" \"vite/**/*.{js,jsx,cjs,mjs,ts,tsx,cts,mts}\" \"*.{js,jsx,cjs,mjs,ts,tsx,cts,mts}\" eslint.config.mjs .prettierrc.cjs",
    "format:write": "prettier --write \"src/**/*.{vue,js,jsx,cjs,mjs,ts,tsx,cts,mts}\" \"tests/**/*.{vue,js,jsx,cjs,mjs,ts,tsx,cts,mts}\" \"vite/**/*.{js,jsx,cjs,mjs,ts,tsx,cts,mts}\" \"*.{js,jsx,cjs,mjs,ts,tsx,cts,mts}\" eslint.config.mjs .prettierrc.cjs",
    "test": "vitest",
    "test:run:raw": "vitest run",
    "test:run": "npm run test:warning-oracle && node scripts/quality/run-with-warning-oracle.mjs test",
    "test:warning-oracle": "node --test --test-isolation=none scripts/quality/framework-warning-oracle.test.mjs",
    "test:ui": "vitest --ui",
    "coverage:raw": "vitest run --coverage",
    "coverage": "npm run test:warning-oracle && node scripts/quality/run-with-warning-oracle.mjs coverage"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "3dmol": "2.5.5",
    "axios": "^1.2.6",
    "element-plus": "2.14.3",
    "file-saver": "^2.0.5",
    "js-cookie": "^3.0.1",
    "nprogress": "^0.2.0",
    "pinia": "4.0.2",
    "vue": "3.5.40",
    "vue-element-plus-x": "1.3.2",
    "vue-i18n": "11.4.7",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/babel__core": "7.20.5",
    "@types/js-cookie": "^3.0.2",
    "@types/node": "26.1.1",
    "@types/nprogress": "^0.2.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.7.0",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.7.0",
    "happy-dom": "20.11.1",
    "npm-run-all2": "9.0.2",
    "prettier": "3.9.6",
    "sass": "1.101.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.0",
    "unplugin-auto-import": "21.0.0",
    "vite": "npm:rolldown-vite@7.3.1",
    "vite-plugin-compression2": "2.5.3",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.8"
  }
}
