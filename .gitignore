# ====================================================================
# Phytomni-Web .gitignore
# Polyglot monorepo: apps/web (Vue+Vite+TS) + apps/server (Go) + repo-wide
# Python tooling (pyproject.toml hosts the scan_secrets pytest runner).
# Grouped by concern; dead rules pruned on 2026-06-27.
# ====================================================================

# ---- OS-generated files ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ---- IDE / editor ----
.idea/
.vscode/
*.swp
*.swo
*~

# ---- Logs ----
*.log

# ---- Generic temp / scratch ----
tmp/
temp/
.cache/

# ---- Secrets & local env (templates use *.example suffix) ----
# Root dotenv (generic)
.env.local
.env.production
.env.development
# Go service config (real credentials; template: apps/server/config/app.yml.example)
apps/server/config/app.yml
# Frontend Vite mode env (templates: apps/web/.env.dev.example, .env.production.example)
apps/web/.env
apps/web/.env.dev
apps/web/.env.dev.local
apps/web/.env.prod
apps/web/.env.staging

# ---- Go (apps/server) ----
*.exe
*.out
*.app
*.test
*.prof
bin/
pkg/
go/pkg/mod/
# compiled server binary (`go build -o phytomni-server .`)
apps/server/phytomni-server

# ---- Python (repo-wide tooling: scripts/ + pyproject.toml) ----
# Virtual environments
.venv/
venv/
env/
# Bytecode
__pycache__/
*.py[cod]
*$py.class
# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
# Packaging artifacts
build/
dist/
*.egg-info/
# Version pins / lockfiles (uv.lock kept OUT of VCS for tooling env)
.python-version
uv.lock
# Jupyter
.ipynb_checkpoints/

# ---- Databases (SQLite; includes .codegraph/codegraph.db) ----
*.db
*.sqlite
*.sqlite3
server_tasks.db

# ---- Local agent / AI-tool context (per-machine, never shared) ----
.claude
CLAUDE.md
.codex
AGENTS.md
AGENTS.local.md
AGENTS.md.pre-compose.bak
agents-compose.json
.agents
skills-lock.json
.superpowers
.cursor
# Superpowers default plan/spec dump path — never commit; local plans live in .cursor/plans
docs/superpowers/
.codegraph
.understand-anything
