#
# Pre-push hook: use the complete repository gate by default. The scoped path
# is an explicit local-iteration opt-in and must not be used for release pushes.

set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

case "${PHYTOMNI_SCOPED_GATE:-}" in
    "")
        exec make full
        ;;
    1)
        exec make prepush
        ;;
    *)
        printf '%s\n' 'PHYTOMNI_SCOPED_GATE must be unset or exactly 1' >&2
        exit 2
        ;;
esac
