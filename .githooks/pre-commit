#
# Pre-commit hook: scan staged files for likely secrets, then run the staged
# repository quality gate. Activate by running scripts/install_git_hooks.sh
# once per local clone (sets core.hooksPath to .githooks).

set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if command -v python3 >/dev/null 2>&1; then
    python3 scripts/scan_secrets.py --staged
else
    python scripts/scan_secrets.py --staged
fi

exec make precommit
